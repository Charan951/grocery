# Copy to .env and fill with real values. Never commit the real .env.

PORT=5000

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=Cluster0

# JWT signing secrets (required) — use long random strings, rotate on exposure
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis (used for rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# SMS / OTP. Leave SMS_PROVIDER blank for local test mode: no SMS is sent and the
# OTP is always "000000". Set to msg91|twilio + credentials to send real codes.
SMS_PROVIDER=
OTP_TEST_MODE=true
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay. With real (test or live) keys + PAYMENTS_TEST_MODE=false the server
# creates real gateway orders and verifies the HMAC signature. Leave blank /
# "mock_*" (or PAYMENTS_TEST_MODE=true) to skip verification for local dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_TEST_MODE=true

# Firebase Cloud Messaging (optional). Provide a service-account JSON (raw or
# base64) to enable push for delivery offers + customer order updates. Leave
# blank and every push is a silent no-op.
FIREBASE_SERVICE_ACCOUNT=
# ...or point GOOGLE_APPLICATION_CREDENTIALS at a service-account file instead.

# Set to "production" to disable destructive catalog re-seeding on boot
NODE_ENV=development

# Email (SMTP). Used to email login credentials to delivery partners when an
# admin creates their account (and on password reset). For Gmail, EMAIL_USER is
# the address and EMAIL_APP_PASSWORD is a 16-char App Password (2FA required),
# not the account password. Leave blank and email sending is a silent no-op.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=FreshCart <no-reply@freshcart.com>
DELIVERY_APP_LOGIN_URL=
# Set MAIL_TEST_MODE=true in tests to capture mail in an in-memory outbox.
MAIL_TEST_MODE=false
