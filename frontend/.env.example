# FreshCart Frontend Environment Configuration (Example)
# Copy to .env and adjust as necessary for your deployment.

# Base URL for API endpoints.
# - Local dev with direct backend access:
#     VITE_API_URL=http://localhost:5000/api
# - Local dev using Vite dev proxy:
#     VITE_API_URL=/api
# - Production deployment:
#     VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Base host URL for Socket.IO realtime connection
# If left blank, automatically resolves from VITE_API_URL or window.location.origin
VITE_SOCKET_URL=http://localhost:5000
