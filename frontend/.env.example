# FreshCart Frontend Environment Configuration (Example)
# Copy to .env and adjust as necessary for your deployment.

# Backend server URL.
# Socket.IO connection URL is automatically derived from this origin.
# REST API endpoints automatically append '/api'.
#
# - Local dev:
#     VITE_API_URL=http://localhost:5000
# - Production deployment:
#     VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:5000
